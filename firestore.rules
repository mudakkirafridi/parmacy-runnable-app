rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /stores/{store} {
   function me(){return get(/databases/$(database)/documents/stores/$(store)/members/$(request.auth.uid)).data;}
   function active(){return request.auth!=null && me().active==true;}
   function owner(){let m=me();return request.auth!=null && m.active && m.role=='owner';}
   function access(module,action){let m=me();return request.auth!=null && m.active && (m.role=='owner' || (module!='owner' && ((m.role=='manager' && !(module in ['salary','zakat','zakat_companies','loans','committee'])) || (module+':'+action) in m.permissions)));}
   function config(){return get(/databases/$(database)/documents/stores/$(store)).data;}
   function control(){let path=/databases/$(database)/documents/stores/$(store)/control/periods;return get(path).data;}
   function definition(e){return e.definition;}
   function trusted(e){return e.definition==get(/databases/$(database)/documents/system/postingTypes).data[e.type];}
   function resolve(template,e){return template.replace('[{]party[}]',e.get('party','')).replace('[{]account[}]',e.get('account','')).replace('[{]category[}]',e.get('category','')).replace('[{]target[}]',e.get('target',''));}

   function zero(){return {'effects':{},'debitAccount':'','creditAccount':''};}
   function amountOK(e){let d=definition(e);return e.amount is int && e.amount<=900000000000 && (e.amount>0 || (d.allowZero && e.amount==0));}
   function dayOK(date){let p=date.split('-');let k=request.time+duration.value(5,'h');return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && int(p[1])>=1 && int(p[1])<=12 && int(p[2])>=1 && int(p[2])<=31 && timestamp.date(int(p[0]),int(p[1]),int(p[2])) <= timestamp.date(k.year(),k.month(),k.day()) && date>control().lockedThrough;}
   function today(date){let k=request.time+duration.value(5,'h');let p=date.split('-');return int(p[0])==k.year() && int(p[1])==k.month() && int(p[2])==k.day();}
   function statePath(module){return /databases/$(database)/documents/stores/$(store)/modules/$(module);}
   function entryPath(id){return /databases/$(database)/documents/stores/$(store)/entries/$(id);}
   function original(state){return get(entryPath(state.lastOriginal)).data;}
   function allocatedOK(e){let a=e.allocations;return a is list && a.size()<=3 && (a.size()<2 || a[0].id!=a[1].id) && (a.size()<3 || (a[0].id!=a[2].id && a[1].id!=a[2].id)) && e.allocatedAmount is int && (
    (a.size()==0&&e.allocatedAmount==0) || (a.size()==1&&e.allocatedAmount==a[0].amount) ||
    (a.size()==2&&e.allocatedAmount==a[0].amount+a[1].amount) || (a.size()==3&&e.allocatedAmount==a[0].amount+a[1].amount+a[2].amount));}
   function allocationShape(e,i){return e.allocations.size()<=i || (e.allocations[i].id is string && e.allocations[i].amount is int && e.allocations[i].amount>0);}
   function effectShape(e){return e.effects.keys().hasOnly([e.debitAccount,e.creditAccount]) && e.effects.keys().hasAll([e.debitAccount,e.creditAccount]) && (
    (e.debitAccount==e.creditAccount && e.effects[e.debitAccount]==0) || (e.debitAccount!=e.creditAccount && e.effects[e.debitAccount]==e.amount && e.effects[e.creditAccount]==-e.amount));}
   function normalShape(e){let d=definition(e);return trusted(e) && d.module!='removed' && e.module==d.module && amountOK(e)
    && e.debitAccount==resolve(d.debit,e) && e.creditAccount==resolve(d.credit,e) && (!d.owner||owner())
    && (!(d.partyRequired||d.debit.matches('.*[{]party[}].*')||d.credit.matches('.*[{]party[}].*')) || e.get('party','')!='')
    && allocatedOK(e) && allocationShape(e,0)&&allocationShape(e,1)&&allocationShape(e,2)
    && (d.allocate||e.allocations.size()==0) && e.allocatedAmount<=e.amount && (!d.allocate||d.creditReturn||e.allocatedAmount==e.amount||e.get('allowAdvance',false))
    && (!(d.applyCredit||e.type=='salary_apply')||e.allocatedAmount==e.amount) && (!(d.obligation||d.period)||e.reference!='')
    && (!e.debitAccount.matches('^money:.*') || e.debitAccount.split(':')[1] in config().accounts)
    && (!e.creditAccount.matches('^money:.*') || e.creditAccount.split(':')[1] in config().accounts)
    && (e.type!='transfer'||e.account!=e.target)
    && (e.type!='daily_sales'||!e.keys().hasAny(['cash','bank','credits','returns','refundCash','refundBank','retained','reductions'])) && effectShape(e);}
   function delta(e,adjust,key){return e.effects.get(key,0)-adjust.effects.get(key,0);}
   function noncash(e,adjust,state,old,key){return (key.matches('^money:.*') && !(key in state.balances)) || (!key.matches('^money:.*') && state.balances.get(key,0)==old.balances.get(key,0)+delta(e,adjust,key));}
   function balancesOK(e,adjust,state,old){return !('' in state.balances) && state.balances.diff(old.balances).affectedKeys().hasOnly([e.debitAccount,e.creditAccount,adjust.debitAccount,adjust.creditAccount])
    && noncash(e,adjust,state,old,e.debitAccount)&&noncash(e,adjust,state,old,e.creditAccount) && (adjust.debitAccount=='' || ((adjust.debitAccount==e.debitAccount||adjust.debitAccount==e.creditAccount||noncash(e,adjust,state,old,adjust.debitAccount))&&(adjust.creditAccount==e.debitAccount||adjust.creditAccount==e.creditAccount||noncash(e,adjust,state,old,adjust.creditAccount))));}
   function allocationKeys(source,state,old,extra){let a=source.allocations;let keys=state.obligations.diff(old.obligations).affectedKeys();return
    (a.size()==0&&keys.hasOnly(extra)) || (a.size()==1&&keys.hasOnly([a[0].id].concat(extra))) ||
    (a.size()==2&&keys.hasOnly([a[0].id,a[1].id].concat(extra))) || (a.size()==3&&keys.hasOnly([a[0].id,a[1].id,a[2].id].concat(extra)));}
   function allocationRow(source,state,old,i,reversing){
    let a=source.allocations.concat([{'id':'','amount':0},{'id':'','amount':0},{'id':'','amount':0}])[i];
    let before=old.obligations.get(a.id,{});let after=state.obligations.get(a.id,{});
    return source.allocations.size()<=i || (before.party==source.party && before.module==source.module
     && after.diff(before).affectedKeys().hasOnly(['remaining']) && (
      (reversing && after.remaining==before.remaining+a.amount) || (!reversing && after.remaining==before.remaining-a.amount && (source.definition.creditReturn||a.amount<=before.remaining))));}
   function obligationRows(source,state,old,reversing){return source.allocations.size()==0 || (allocationRow(source,state,old,0,reversing)&&allocationRow(source,state,old,1,reversing)&&allocationRow(source,state,old,2,reversing));}
   function obligationPost(e,state,old){let d=definition(e);return (e.allocations.size()==0 || obligationRows(e,state,old,false)) && (
    (!d.obligation&&allocationKeys(e,state,old,[])) || (d.obligation&&allocationKeys(e,state,old,[e.id])&&!(e.id in old.obligations)
    && state.obligations[e.id]=={'id':e.id,'party':e.party,'module':e.module,'reference':e.reference,'original':e.amount,'remaining':e.amount,'date':e.date,'due':e.get('due',e.date)}));}
   function obligationReverse(source,state,old){let d=definition(source);return obligationRows(source,state,old,true) && (
    (!d.obligation&&allocationKeys(source,state,old,[])) || (d.obligation&&allocationKeys(source,state,old,[source.id])&&old.obligations[source.id].remaining==old.obligations[source.id].original&&!(source.id in state.obligations)));}
   function uniquePut(e,state,old,key){return !(key in old.unique) && e.unique==key && state.unique.diff(old.unique).affectedKeys().hasOnly([key]) && state.unique[key]==e.id;}
   function uniquePost(e,state,old){let d=definition(e);return
    (!d.onePerDay&&!d.obligation&&!d.period&&e.unique==null&&state.unique==old.unique)
    || (d.onePerDay&&uniquePut(e,state,old,'daily_sales:'+e.date))
    || ((d.obligation||d.period)&&uniquePut(e,state,old,e.type+':'+e.get('party','')+':'+e.reference));}
   function uniqueReverse(source,state,old){return (source.unique==null&&state.unique==old.unique) ||
    (source.unique!=null&&!(source.unique in state.unique)&&state.unique.diff(old.unique).affectedKeys().hasOnly([source.unique]));}
   function advanceShape(e,old){let available=old.unallocated.get('supplier:'+e.get('party',''),0);return
    ((e.type=='supplier_payment'||e.type=='supplier_return')&&e.advanceDelta==e.amount-e.allocatedAmount)
    || (e.type=='supplier_apply'&&e.advanceDelta==-e.amount)
    || (e.type=='supplier_refund'&&((e.amount<=available&&e.advanceDelta==-e.amount)||(e.amount>available&&e.advanceDelta==-available)))
    || (!(e.type in ['supplier_payment','supplier_return','supplier_apply','supplier_refund'])&&e.advanceDelta==0);}
   function advanceState(e,state,old){let key='supplier:'+e.get('party','');return state.unallocated.get(key,0)==old.unallocated.get(key,0)+e.advanceDelta && state.unallocated.get(key,0)>=0
    && ((e.advanceDelta==0&&state.unallocated==old.unallocated)||(e.advanceDelta!=0&&state.unallocated.diff(old.unallocated).affectedKeys().hasOnly([key])));}
   function limitsOK(e,old){return (e.type!='loan_repay'||e.amount<=-old.balances.get(e.debitAccount,0))
    && (e.type!='salary_apply'||e.amount<=old.balances.get(e.creditAccount,0)) && (e.type!='supplier_refund'||e.amount<=old.balances.get(e.creditAccount,0));}
   function reversalShape(e,source){return e.type=='reversal'&&source.type!='reversal'&&!source.keys().hasAny(['reversedBy'])&&e.reference==source.id&&e.module==source.module&&e.amount==source.amount&&e.reason is string&&e.reason.size()>0
    && e.debitAccount==source.creditAccount&&e.creditAccount==source.debitAccount&&e.allocations==source.allocations&&e.allocatedAmount==source.allocatedAmount&&e.advanceDelta==-source.advanceDelta
    && e.effects.keys()==source.effects.keys()&&e.effects[e.debitAccount]==-source.effects[e.debitAccount]&&e.effects[e.creditAccount]==-source.effects[e.creditAccount]
    && getAfter(entryPath(source.id)).data.reversedBy==e.id;}
   function reversalLimits(source,state){let party=source.get('party','');return (source.type!='salary_advance' || state.balances.get('salaryAdvance:'+party,0)>=0);}
   function accountBefore(account){return get(/databases/$(database)/documents/stores/$(store)/accounts/$(account)).data.balance;}
   function moneyOK(e,adjust,state,key){let account=key.split(':').concat(['__none'])[1];let change=delta(e,adjust,key);let path=/databases/$(database)/documents/stores/$(store)/accounts/$(account);return
    !key.matches('^money:.*') || change==0 || (getAfter(path).data.balance==accountBefore(account)+change&&getAfter(path).data.lastOperation==state.lastOperation&&getAfter(path).data.lastModule==e.module);}
   function allMoneyOK(e,adjust,state){return
    (!e.debitAccount.matches('^money:.*') || moneyOK(e,adjust,state,e.debitAccount)) && (!e.creditAccount.matches('^money:.*') || moneyOK(e,adjust,state,e.creditAccount))
    && (adjust.debitAccount=='' || ((adjust.debitAccount==e.debitAccount||adjust.debitAccount==e.creditAccount||!adjust.debitAccount.matches('^money:.*') || moneyOK(e,adjust,state,adjust.debitAccount))&&(adjust.creditAccount==e.debitAccount||adjust.creditAccount==e.creditAccount||!adjust.creditAccount.matches('^money:.*') || moneyOK(e,adjust,state,adjust.creditAccount))));}
   function common(e,adjust,state,old){return balancesOK(e,adjust,state,old)&&allMoneyOK(e,adjust,state);}
   function correctionLimits(e,source,old){return
     (source.type!='salary_advance'||old.balances.get(source.debitAccount,0)-source.effects.get(source.debitAccount,0)>=0)
     && (e.type!='salary_apply'||e.amount<=old.balances.get(e.creditAccount,0)-source.effects.get(e.creditAccount,0))
     && (e.type!='supplier_refund'||e.amount<=old.balances.get(e.creditAccount,0)-source.effects.get(e.creditAccount,0))
     && (e.type!='loan_repay'||e.amount<=-(old.balances.get(e.debitAccount,0)-source.effects.get(e.debitAccount,0)));}
   function simpleObligationEdit(e,source,state,old){let d=source.definition;return
    (!d.obligation&&state.obligations==old.obligations) || (d.obligation&&old.obligations[source.id].remaining==source.amount
      && !(source.id in state.obligations)&&state.obligations.diff(old.obligations).affectedKeys().hasOnly([source.id,e.id])
      && state.obligations[e.id]=={'id':e.id,'party':e.party,'module':e.module,'reference':e.reference,'original':e.amount,'remaining':e.amount,'date':e.date,'due':e.get('due',e.date)});}
   function simpleUniqueEdit(e,source,state,old){return
    (source.unique==null&&e.unique==null&&state.unique==old.unique)
    || (source.unique!=null&&e.unique!=null&&state.unique.diff(old.unique).affectedKeys().hasOnly([source.unique,e.unique])
       && (source.unique==e.unique||!(e.unique in old.unique))&&state.unique[e.unique]==e.id
       && (source.unique==e.unique||!(source.unique in state.unique))
       && e.unique==(e.definition.onePerDay?'daily_sales:'+e.date:e.type+':'+e.get('party','')+':'+e.reference));}
   function allocatedFor(a,id){return (a[0].id==id?a[0].amount:0)+(a[1].id==id?a[1].amount:0)+(a[2].id==id?a[2].amount:0);}
   function editedAllocationRow(id,e,state,old,restored,paid){let before=old.obligations.get(id,{});let after=state.obligations.get(id,{});return
     (before.module==e.module && (paid==0||before.party==e.party) && after.diff(before).affectedKeys().hasOnly(['remaining'])
      && after.remaining==before.remaining+restored-paid && (paid==0||e.definition.creditReturn||paid<=before.remaining+restored));}
   function paymentObligationEdit(e,source,state,old){
    let pad=[{'id':'','amount':0},{'id':'','amount':0},{'id':'','amount':0}];let sa=source.allocations.concat(pad);let na=e.allocations.concat(pad);let nk=[na[0].id,na[1].id,na[2].id];
    return !source.definition.obligation && state.unique==old.unique && !('' in state.obligations)
      && state.obligations.diff(old.obligations).affectedKeys().hasOnly([sa[0].id,sa[1].id,sa[2].id].concat(nk))
      && (sa[0].id in nk || editedAllocationRow(sa[0].id,e,state,old,sa[0].amount,0))
      && (sa[1].id in nk || editedAllocationRow(sa[1].id,e,state,old,sa[1].amount,0))
      && (sa[2].id in nk || editedAllocationRow(sa[2].id,e,state,old,sa[2].amount,0))
      && (na[0].id==''||editedAllocationRow(na[0].id,e,state,old,allocatedFor(sa,na[0].id),na[0].amount))&&(na[1].id==''||editedAllocationRow(na[1].id,e,state,old,allocatedFor(sa,na[1].id),na[1].amount))&&(na[2].id==''||editedAllocationRow(na[2].id,e,state,old,allocatedFor(sa,na[2].id),na[2].amount));
   }
   function correctionOK(e,state,old){
    let source=original(state);let rev=getAfter(entryPath(state.lastReversal)).data;let mid=state.correctionState;
    return e.type==source.type && e.replaces==source.id && state.lastKind=='correct'
      && rev.reference==source.id && correctionLimits(e,source,old)
      && ((source.allocations.size()==0&&e.allocations.size()==0&&simpleObligationEdit(e,source,state,old)&&simpleUniqueEdit(e,source,state,old))
        || ((source.allocations.size()>0||e.allocations.size()>0)&&paymentObligationEdit(e,source,state,old)))
      && ((source.advanceDelta==0&&e.advanceDelta==0&&state.unallocated==old.unallocated&&advanceShape(e,old)) || ((source.advanceDelta!=0||e.advanceDelta!=0)&&advanceState(rev,mid,old)&&advanceShape(e,mid)&&advanceState(e,state,mid)))
      && common(e,source,state,old);
   }

   function operationOK(e,state,old){return
    (e.type!='reversal' && !e.keys().hasAny(['replaces']) && state.lastKind=='post' && state.lastOriginal=='' && state.lastReversal=='' && obligationPost(e,state,old)&&uniquePost(e,state,old)&&advanceShape(e,old)&&advanceState(e,state,old)&&limitsOK(e,old)&&common(e,zero(),state,old))
    || (e.type=='reversal' && !e.get('correctionReversal',false) && state.lastKind=='reverse'&&state.lastOriginal==e.reference&&state.lastReversal==e.id&&reversalLimits(original(state),state)&&obligationReverse(original(state),state,old)&&uniqueReverse(original(state),state,old)&&advanceState(e,state,old)&&common(e,zero(),state,old))
    || (e.type!='reversal' && e.keys().hasAny(['replaces']) && 'correctionState' in state && correctionOK(e,state,old))
    || (!('correctionState' in state) && e.type=='expense' && e.keys().hasAny(['replaces']) && state.lastKind=='correct'&&owner()&&original(state).type=='expense'&&e.replaces==original(state).id&&state.obligations==old.obligations&&state.unique==old.unique&&state.unallocated==old.unallocated
      && common(e,original(state),state,old));}
   function ownerShare(owners,i){return owners.concat([{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0}])[i].shareBps;}
   function ownerShape(owners,i){return owners.size()<=i||(owners[i].id is string&&owners[i].name is string&&owners[i].name.size()>0&&owners[i].shareBps is int&&owners[i].shareBps>0&&owners[i].shareBps<=10000);}
   function ownersOK(owners){let padded=owners.concat([{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0},{'shareBps':0}]);return owners is list&&owners.size()>0&&owners.size()<=10&&ownerShape(owners,0)&&ownerShape(owners,1)&&ownerShape(owners,2)&&ownerShape(owners,3)&&ownerShape(owners,4)&&ownerShape(owners,5)&&ownerShape(owners,6)&&ownerShape(owners,7)&&ownerShape(owners,8)&&ownerShape(owners,9)&&(padded[0].shareBps+padded[1].shareBps+padded[2].shareBps+padded[3].shareBps+padded[4].shareBps+padded[5].shareBps+padded[6].shareBps+padded[7].shareBps+padded[8].shareBps+padded[9].shareBps)==10000;}


   function accountWrite(next,account){let state=getAfter(statePath(next.lastModule)).data;let e=getAfter(entryPath(next.lastOperation)).data;return
    (state.lastKind!='correct'&&next.balance==accountBefore(account)+delta(e,zero(),'money:'+account))
    || (state.lastKind=='correct'&&next.balance==accountBefore(account)+delta(e,original(state),'money:'+account));}
   allow read: if active();
   allow create,delete: if false;
   allow update: if owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','accounts','owners','zakatTarget']) && request.resource.data.name is string && request.resource.data.name.size()>0 && ownersOK(request.resource.data.owners) && request.resource.data.accounts is list && request.resource.data.accounts.size()<=20 && request.resource.data.accounts.hasAll(['cash','bank']) && request.resource.data.zakatTarget is int && request.resource.data.zakatTarget>=0;
   match /members/{uid}{
    allow read: if request.auth!=null && (request.auth.uid==uid || owner());
    allow create,update: if owner() && uid!=request.auth.uid && request.resource.data.role in ['owner','manager','staff'] && request.resource.data.active is bool && request.resource.data.permissions is list;
    allow delete: if false;
   }
   function orderPath(id){return /databases/$(database)/documents/stores/$(store)/orders/$(id);}
   function linkedOrder(e){return e.get('orderId','')=='' || orderBillLink(e);}
   function orderBillLink(e){let before=get(orderPath(e.orderId)).data;let after=getAfter(orderPath(e.orderId)).data;return
     e.type=='supplier_bill'&&(before.status=='open'||(before.status=='received'&&e.get('replaces','')==before.billId))
     &&after.status=='received'&&after.billId==e.id&&after.billAmount==e.amount&&after.party==e.party;}
   function orderShape(o,id){return o.keys().hasOnly(['id','party','companyName','staffId','staffName','date','amount','notes','status','billId','billAmount','updatedBy','updatedAt'])
     && o.id==id && o.party is string && o.party.size()>0 && o.companyName is string && o.companyName.size()>0
     && o.staffId is string && o.staffId.size()>0 && o.staffName is string && o.staffName.size()>0
     && o.amount is int && o.amount>0 && o.amount<=900000000000 && o.notes is string && o.notes.size()<=2000
     && o.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && o.updatedBy==request.auth.uid && o.updatedAt==request.time;}
   function receivedOrder(next,old,id){let bill=getAfter(entryPath(next.billId)).data;return
     next.diff(old).affectedKeys().hasOnly(['status','billId','billAmount','updatedBy','updatedAt'])
     && (old.status=='open'||(old.status=='received'&&bill.get('replaces','')==old.billId))
     && bill.type=='supplier_bill'&&bill.orderId==id&&bill.party==old.party&&bill.amount==next.billAmount&&bill.createdAt==request.time;}
   function orderUpdate(next,old,id){return
     access('suppliers','post')&&next.updatedBy==request.auth.uid&&next.updatedAt==request.time && (
       (old.status=='open'&&next.status in ['open','cancelled']&&next.billId==''&&next.billAmount==0&&orderShape(next,id))
       || (next.status=='received'&&receivedOrder(next,old,id))
       || (owner()&&old.status=='received'&&next.status=='open'&&next.billId==''&&next.billAmount==0
         && next.diff(old).affectedKeys().hasOnly(['status','billId','billAmount','updatedBy','updatedAt'])
         && getAfter(entryPath(getAfter(entryPath(old.billId)).data.reversedBy)).data.createdAt==request.time));}
   match /orders/{id}{
     allow read: if access('suppliers','read');
     allow create: if access('suppliers','post')&&orderShape(request.resource.data,id)&&request.resource.data.status=='open'&&request.resource.data.billId==''&&request.resource.data.billAmount==0;
     allow update: if orderUpdate(request.resource.data,resource.data,id);
     allow delete: if false;
   }
   match /profiles/{id}{
    allow read: if access(resource.data.module,'read');
    allow create: if access(request.resource.data.module,'post') && request.resource.data.id==id && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.module in ['suppliers','salary','rent','loans','zakat','zakat_companies','people','committee'];
    allow update: if access(resource.data.module,'post') && request.resource.data.module==resource.data.module && request.resource.data.id==id && request.resource.data.name is string && request.resource.data.name.size()>0;
    allow delete: if false;
   }
   function moduleWrite(next,old,module){let e=getAfter(entryPath(next.lastOperation)).data;return
     access(module,'post') && next.keys().hasOnly(['balances','obligations','unique','unallocated','lastOperation','lastKind','lastOriginal','lastReversal','operation','correctionState'])
     && next.lastOperation!=old.lastOperation && !exists(entryPath(next.lastOperation))
     && e.diff(next.operation).affectedKeys().hasOnly(['createdAt']) && next.operation.module==module
     && operationOK(next.operation,next,old) && e.createdBy==request.auth.uid && e.createdAt==request.time;}
   function entryCreate(e,id){let state=getAfter(statePath(e.module)).data;return
     access(e.module,'post') && e.id==id && e.createdBy==request.auth.uid && e.createdAt==request.time && dayOK(e.date) && linkedOrder(e)
     && ((e.type!='reversal'&&normalShape(e)&&state.lastOperation==id) || (e.type=='reversal'&&state.lastReversal==id&&reversalShape(e,original(state))));}
   function originalOrderUpdate(source,id){let order=getAfter(orderPath(source.orderId)).data;return
     (order.status=='open'&&order.billId=='') || (order.status=='received'&&getAfter(entryPath(order.billId)).data.get('replaces','')==id);}
   function originalUpdate(next,source,id){let rev=getAfter(entryPath(next.reversedBy)).data;let state=getAfter(statePath(source.module)).data;return
     owner() && next.diff(source).affectedKeys().hasOnly(['reversedBy']) && !source.keys().hasAny(['reversedBy'])
     && rev.reference==id && rev.type=='reversal' && rev.createdAt==request.time
     && (source.get('orderId','')=='' || originalOrderUpdate(source,id))
     && state.lastOriginal==id && state.lastReversal==next.reversedBy;}
   function accountUpdate(next,account){let state=getAfter(statePath(next.lastModule)).data;let e=getAfter(entryPath(next.lastOperation)).data;return
     next.keys().hasOnly(['balance','lastOperation','lastModule'])&&next.balance is int&&account in config().accounts&&access(next.lastModule,'post')
     && e.createdAt==request.time&&state.lastOperation==next.lastOperation
     && ((state.lastKind!='correct'&&next.balance==accountBefore(account)+delta(e,zero(),'money:'+account)) || (state.lastKind=='correct'&&next.balance==accountBefore(account)+delta(e,original(state),'money:'+account)));}
   match /modules/{module}{
    allow read: if access(module,'read')||access(module,'post');
    allow create,update: if moduleWrite(request.resource.data,resource==null?{'balances':{},'obligations':{},'unique':{},'unallocated':{},'lastOperation':'','lastKind':'','lastOriginal':'','lastReversal':''}:resource.data,module);
    allow delete: if false;
   }
   match /entries/{id}{
    allow get: if active() && (resource == null || access(resource.data.module,'read'));
    allow list: if access(resource.data.module,'read');
    allow create: if entryCreate(request.resource.data,id);
    allow update: if originalUpdate(request.resource.data,resource.data,id);
    allow delete: if false;
   }
   match /accounts/{account}{
    allow read: if access('cashbook','read')||access('cashbook','post');
    allow create,update: if accountUpdate(request.resource.data,account);
    allow delete: if false;
   }
   match /control/periods{
    allow read: if active();
    allow create,update: if access('cashbook','post') && request.resource.data.keys().hasOnly(['lockedThrough']) && today(request.resource.data.lockedThrough) && request.resource.data.lockedThrough>control().lockedThrough && getAfter(/databases/$(database)/documents/stores/$(store)/closures/$(request.resource.data.lockedThrough)).data.at==request.time;
    allow delete: if false;
   }
   match /closures/{date}{
    allow read: if access('cashbook','read');
    allow create: if access('cashbook','post') && today(date) && request.resource.data.date==date && request.resource.data.at==request.time && request.resource.data.by==request.auth.uid
     && request.resource.data.counted is int && request.resource.data.counted>=0 && request.resource.data.expected==accountBefore('cash')
     && request.resource.data.difference==request.resource.data.counted-request.resource.data.expected
     && (request.resource.data.difference==0 || (request.resource.data.reason is string && request.resource.data.reason.size()>0))
     && getAfter(/databases/$(database)/documents/stores/$(store)/control/periods).data.lockedThrough==date;
    allow update,delete: if false;
   }
   match /{document=**}{allow read,write:if false;}
  }
  match /{document=**}{allow read,write:if false;}
 }
}
